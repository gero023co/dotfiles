{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/makima.png",
    "width": 27,
    "preserveAspectRatio": true,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },

  "display": {
    "separator": " ",
    "brightColor": false,
    "color": {
      "keys": "default",
      "output": "default"
    }
  },

  "modules": [
    // ── top box ────────────────────────────────────────────────────
    {
      "type": "custom",
      "key": "╭──────────╮"
    },

    {
      "type": "title",
      "keyIcon": "\uf007",
      "key": "│ {#red}{icon}{#} user   │",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "keyIcon": "\uf108",
      "key": "│ {#green}{icon}{#} hname  │",
      "format": "{host-name}"
    },
    {
      "type": "uptime",
      "keyIcon": "\uf017",
      "key": "│ {#yellow}{icon}{#} uptime │"
    },
    {
      "type": "os",
      "keyIcon": "\uf303",
      "key": "│ {#blue}{icon}{#} distro │"
    },
    {
      "type": "kernel",
      "keyIcon": "\uf085",
      "key": "│ {#magenta}{icon}{#} kernel │"
    },
    {
      "type": "wm",
      "keyIcon": "\uf2d0",
      "key": "│ {#cyan}{icon}{#} wm     │",
      "format": "{pretty-name} ({protocol-name})"
    },
    {
      "type": "terminal",
      "keyIcon": "\uf120",
      "key": "│ {#red}{icon}{#} term   │"
    },
    {
      "type": "shell",
      "keyIcon": "\uf489",
      "key": "│ {#green}{icon}{#} shell  │"
    },
    {
      "type": "cpu",
      "keyIcon": "\uf2db",
      "key": "│ {#yellow}{icon}{#} cpu    │"
    },
    {
      "type": "disk",
      "keyIcon": "\uf0a0",
      "key": "│ {#blue}{icon}{#} disk   │",
      "folders": "/home"
    },
    {
      "type": "memory",
      "keyIcon": "\uf233",
      "key": "│ {#magenta}{icon}{#} memory │"
    },

    // ── separator + colors + bottom box ────────────────────────────
    {
      "type": "custom",
      "key": "├──────────┤"
    },
    {
      "type": "colors",
      "keyIcon": "\uf111",
      "key": "│ {#cyan}{icon}{#} colors │",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "key": "╰──────────╯"
    }
  ]
}
