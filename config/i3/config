# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!
#
# NOTE: after editing this file, reload with Super+Shift+c (reload) or
#       restart i3 with Super+Shift+r (restart, keeping windows and layout).
#       Validate the syntax without reloading: i3 -C -c ~/.config/i3/config


# ---------------------------------------------------------------------------
# MODIFIER KEY
# $mod = Super (the Windows key). Every $mod+... shortcut is pressed with Super.
set $mod Mod4

# Font (pango) for window titles and, if present, for the bar.
font pango:monospace 8

# Alternative default font, commented out (wizard example).
#font pango:DejaVu Sans Mono 8



# AUTOSTART
# exec_always -> runs on session start AND on every i3 restart
#                (Super+Shift+r). A simple reload (Super+Shift+c)
#                does NOT run it again.
# --no-startup-id -> i3 does not wait for the command to finish: it is launched
#                in the background (without this, i3 would block startup until
#                the program exits).
exec_always --no-startup-id ~/.config/polybar/launch.sh --forest
exec_always --no-startup-id picom --daemon

# Wallpaper (feh). The image is installed to
# ~/.local/share/wallpapers/ by install.sh.
exec_always --no-startup-id ~/.config/i3/wallpaper.sh

# Conky widget (clock/date/weather) inherited from XFCE: sticky on every
# workspace and at the bottom, behind the windows. See ~/.config/i3/conky.sh.
exec_always --no-startup-id ~/.config/i3/conky.sh


# exec (without _always) -> runs only ONCE when the session starts;
# on reload/restart of i3 it does NOT run again (prevents duplicates).

# Launches the .desktop autostart entries of other applications (updaters, etc.)
# with the "i3" environment. NOTE: `dex` is NOT installed -> this command does
# nothing and only leaves this warning in ~/.xsession-errors.
exec --no-startup-id dex --autostart --environment i3

# xss-lock: watches suspend/screen-off (logind) and runs i3lock to lock.
# --transfer-sleep-lock waits for unlock before suspending.
# It is activated with `loginctl lock-session`. NOTE: `xss-lock` is NOT installed.
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# NetworkManager tray (tray) to manage WiFi/networks from the icon.
# exec --no-startup-id nm-applet

# VOLUME with the keyboard multimedia keys.
# $refresh_i3status is a variable that sends SIGUSR1 to i3status so it
# refreshes the bar. NOTE: since we use polybar this is redundant (polybar's
# pulseaudio module updates itself); it is kept just in case.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# With Super + left mouse button: drag a floating window.
# With Super + right mouse button: resize it.
floating_modifier $mod

# Tiled window dragging: dragging by the title bar (or by the window while
# holding Super) makes the window float while moving, and re-tiles it in the
# new position when released.
tiling_drag modifier titlebar



# START TERMINAL
bindsym $mod+Return exec kitty



# CLOSE WINDOW
bindsym $mod+q kill



# APPLICATION LAUNCHER
bindsym $mod+l exec --no-startup-id rofi -show drun

# Power menu (rofi powermenu)
bindsym $mod+x exec --no-startup-id ~/.config/rofi/scripts/powermenu.sh



# CHANGE WINDOW
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right



# MOVE WINDOW
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right



# SPLIT THE SCREEN
# Creates a horizontal split: the next windows go left/right.
bindsym $mod+h split h
# Creates a vertical split: the next windows go above/below.
bindsym $mod+v split v

# Fullscreen for the focused window (container); press again to exit.
bindsym $mod+f fullscreen toggle

# WINDOW GROUP LAYOUT:
bindsym $mod+s layout stacking   # stacked: only the top window is visible
bindsym $mod+w layout tabbed     # tabs: like a browser, with tabs at the top
bindsym $mod+e layout toggle split # toggles between split and stacked

# Toggles the focused window between tiled and floating.
bindsym $mod+Shift+space floating toggle
# Toggles focus between the tiled and the floating window (if one is floating).
bindsym $mod+space focus mode_toggle

# Moves focus up to the parent container (to move/group several windows at once).
bindsym $mod+a focus parent
# Moves focus down to the child container.
#bindsym $mod+d focus child

# MINIMIZE ALL / SHOW DESKTOP
bindsym $mod+d exec --no-startup-id ~/.config/i3/show-desktop.sh

# Daemon: automatically restores hidden windows (Super+D) when a new window is
# opened on the same desktop.
exec_always --no-startup-id ~/.config/i3/i3-hidden.py daemon

# TOGGLE KEYBOARD LAYOUT: system (latam) <-> us.
# (Super+Shift+c is still reload config; this one is only Super+c.)
bindsym $mod+c exec --no-startup-id ~/.config/i3/toggle-layout.sh

# WORKSPACE NAMES.
# Used as variables to avoid repeating the names in every shortcut.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# GO TO A WORKSPACE.
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# SEND the focused window to another workspace (without switching to it).
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# RELOAD the configuration file (changes apply immediately).
bindsym $mod+Shift+c reload
# RESTART i3 in place: keeps windows and layout (useful for updating i3).
bindsym $mod+Shift+r restart
# EXIT i3: shows a confirmation bar (i3-nagbar) before closing the X session.
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# RESIZE MODE (entered with Super+r, not a direct shortcut).
# Inside the mode: j/k/l/ntilde and the arrow keys change the window size.
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym ntilde resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

# Enter resize mode.
bindsym $mod+r mode "resize"

# i3 BAR (i3bar) with i3status.
# -> Disabled: polybar is used now (see ~/.config/polybar/launch.sh)
#bar {
#        status_command i3status
#}



# CUSTOMIZATION



# SELECTION BORDERS (i3 native)
# i3 draws its own borders: picom or any compositor is not required,
# so they add no noticeable load. 2 px is enough to see at a glance which
# window has focus; increase it to 3 if it is hard to tell.
# (Alternatives: `pixel 1` is more subtle, `normal` adds a title bar.)
new_window pixel 2
new_float pixel 2

# Do not hide the border against the screen edges: with `smart` the border
# disappears when there is only one window and the focus reference is lost.
hide_edge_borders none

# Border colors (palette from ~/.config/polybar/forest/colors.ini).
#   focused          -> active window: teal border, light text
#   focused_inactive -> active inside an unfocused container: muted blue
#   unfocused        -> the rest: dark gray, almost imperceptible
#   urgent           -> attention request: red
# Order: border  background  text  indicator  child
client.focused          #6ebbc5 #6ebbc5 #0b1114 #6ebbc5 #6ebbc5
client.focused_inactive #4f8da8 #4f8da8 #d2dadf #4f8da8 #4f8da8
client.unfocused        #2b3842 #2b3842 #d2dadf #2b3842 #2b3842
client.urgent           #c35b48 #c35b48 #ffffff #c35b48 #c35b48



# WINDOW SPACING
# 7 pixels of inner gap between windows (gaps).
# (`gaps outer N` also exists for gaps against the monitor edges,
#  and `gaps horizontal/vertical/...`; here only the inner gap is defined.)
gaps inner 7
# Top gap: polybar (forest theme) is docked at the top, so i3 already reserves
# its 34px automatically. No extra gap is added here: the gap against the bar
# is provided by `gaps inner 7` (the same as on the sides and bottom), and an
# extra `gaps top` duplicated that separation (14px top vs 7px bottom). If more
# air is ever wanted below the bar, use `gaps top N` knowing that it is added
# to `gaps inner`.
gaps top 0
